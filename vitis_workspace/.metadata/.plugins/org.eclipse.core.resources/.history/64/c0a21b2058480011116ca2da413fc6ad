#include "ap_main.h"



hBtn_t hbtncstart;
hBtn_t hbtncwrite;
hBtn_t hbtncread;
hBtn_t hbtncstop;

sw_t switch_mode;



void ap_init()
{
    Switch_init(&switch_mode, GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_3 | GPIO_PIN_4| GPIO_PIN_5 | GPIO_PIN_6 | GPIO_PIN_7);
    I2C_init();
    //LED_Init();
    FND_init();
    Button_Init(&hbtncstart, GPIOD, GPIO_PIN_4);
    Button_Init(&hbtncwrite, GPIOD, GPIO_PIN_5);
    Button_Init(&hbtncread, GPIOD, GPIO_PIN_6);
    Button_Init(&hbtncstop, GPIOD, GPIO_PIN_7);

    FND_SetNum(0);


}


void ap_excute()
{ 
	uint32_t raw_start = GPIO_ReadPin(GPIOD, GPIO_PIN_4);
	    uint32_t raw_write = GPIO_ReadPin(GPIOD, GPIO_PIN_5);

	    xil_printf("Start Pin(4): %d | Write Pin(5): %d\n", raw_start, raw_write);

	    delay_ms(1000); // 1초 대기 (터미널이 터지는 것을 방지)

        
    

}

