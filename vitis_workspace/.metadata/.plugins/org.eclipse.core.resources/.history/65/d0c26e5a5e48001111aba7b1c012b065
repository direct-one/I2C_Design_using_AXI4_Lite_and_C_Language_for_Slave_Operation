 #include "I2C.h"

 



void I2C_init()
{
    I2C->CMD_SIGNAL = 0x00000000;
    I2C->TX_DATA = 0x00000000;

}

void I2C_Start()
{
    I2C->CMD_SIGNAL |= (1<<0);
    I2C->CMD_SIGNAL &= ~(1<<0);
}
void I2C_Write(uint8_t data)
{
    I2C->CMD_SIGNAL |= (1<<1);
    I2C->CMD_SIGNAL &= ~(1<<1);

    while(!(I2C->O_SIGNAL & (1<<0)));
}

void I2C_Stop()
{
    I2C->CMD_SIGNAL |= (1<<3);
    I2C->CMD_SIGNAL &= ~(1<<3);

}


uint8_t I2C_Read(uint8_t NACK)
{
    uint8_t rx_data;

     if(NACK == I2C_NACK){
        I2C->CMD_SIGNAL |= (1<<4); //NACK
     } else {
        I2C->CMD_SIGNAL &= ~(1<<4); //ACK
     }
   
     I2C->CMD_SIGNAL |= (1<<2);
     I2C->CMD_SIGNAL &= ~(1<<2);

     while(!(I2C->O_SIGNAL & (1<<0)));

     rx_data = (uint8_t)(I2C->RX_DATA & 0xff);

     return rx_data;



}

