#include "ap_main.h"



hBtn_t hbtncstart;
hBtn_t hbtncwrite;
hBtn_t hbtncread;
hBtn_t hbtncstop;

sw_t switch_mode;



void ap_init()
{
    Switch_init(&switch_mode, GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_3 | GPIO_PIN_4| GPIO_PIN_5 | GPIO_PIN_6 | GPIO_PIN_7);
    I2C_init();
    //LED_Init();
    FND_init();
    Button_Init(&hbtncstart, GPIOD, GPIO_PIN_4);
    Button_Init(&hbtncwrite, GPIOD, GPIO_PIN_5);
    Button_Init(&hbtncread, GPIOD, GPIO_PIN_6);
    Button_Init(&hbtncstop, GPIOD, GPIO_PIN_7);

    FND_SetNum(0);


}

void ap_excute()
{ 
    xil_printf("Looping\n");
    xil_printf("Raw Start Pin: %d\n", GPIO_ReadPin(GPIOD, GPIO_PIN_4));

    // CMD_START State
    if(Button_GetState(&hbtncstart) == ACT_PUSHED){
        I2C_Start();
        xil_printf("Start\n");
    }
    // CMD_Write state
    if(Button_GetState(&hbtncwrite) == ACT_PUSHED){
        xil_printf("Enter Write\n");
        uint8_t sw_state = Switch_ReadExcute(&switch_mode);
        I2C_Write(sw_state);
        xil_printf("Write\n");
    }
    // CMD_Read State
    if(Button_GetState(&hbtncread) == ACT_PUSHED){
        uint8_t rx_data = I2C_Read(I2C_NACK);
        FND_SetNum(rx_data);
    }
    // CMD_Stop State
    if(Button_GetState(&hbtncstop) == ACT_PUSHED){
        I2C_Stop();
    }
