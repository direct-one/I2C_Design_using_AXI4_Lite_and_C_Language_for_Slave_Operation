#include "ap_main.h"



hBtn_t hbtncstart;
hBtn_t hbtncwrite;
hBtn_t hbtncread;
hBtn_t hbtncstop;

sw_t switch_mode;



void ap_init()
{
    Switch_init(&switch_mode, GPIOA, GPIO_PIN_0 | GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_3 | GPIO_PIN_4| GPIO_PIN_5 | GPIO_PIN_6 | GPIO_PIN_7);
    I2C_init();
    //LED_Init();
    FND_init();
    Button_Init(&hbtncstart, GPIOD, GPIO_PIN_4);
    Button_Init(&hbtncwrite, GPIOD, GPIO_PIN_5);
    Button_Init(&hbtncread, GPIOD, GPIO_PIN_6);
    Button_Init(&hbtncstop, GPIOD, GPIO_PIN_7);

    FND_SetNum(0);


}


void ap_excute()
{ 
	xil_printf("Looping\n");
	    xil_printf("PIN4:%d PIN5:%d PIN6:%d PIN7:%d\n",
	        GPIO_ReadPin(GPIOD, GPIO_PIN_4),
	        GPIO_ReadPin(GPIOD, GPIO_PIN_5),
	        GPIO_ReadPin(GPIOD, GPIO_PIN_6),
	        GPIO_ReadPin(GPIOD, GPIO_PIN_7)
	    );

	    if(Button_GetState(&hbtncstart) == ACT_PUSHED){
	        xil_printf("Start 진입\n");
	        I2C_Start();
	        xil_printf("Start 완료\n");  // ← 여기서 멈추면 I2C_Start() 문제
	    }
	    if(Button_GetState(&hbtncwrite) == ACT_PUSHED){
	        xil_printf("Write 진입\n");
	        uint8_t sw_state = Switch_ReadExcute(&switch_mode);
	        xil_printf("Switch 읽기 완료\n");
	        I2C_Write(sw_state);
	        xil_printf("Write 완료\n");  // ← 여기서 멈추면 I2C_Write() 문제
	    }
	    if(Button_GetState(&hbtncread) == ACT_PUSHED){
	        xil_printf("Read 진입\n");
	        uint8_t rx_data = I2C_Read(I2C_NACK);
	        xil_printf("Read 완료\n");   // ← 여기서 멈추면 I2C_Read() 문제
	        FND_SetNum(rx_data);
	    }
	    if(Button_GetState(&hbtncstop) == ACT_PUSHED){
	        xil_printf("Stop 진입\n");
	        I2C_Stop();
	        xil_printf("Stop 완료\n");   // ← 여기서 멈추면 I2C_Stop() 문제
	    }

        
    

}

