# Keep source files consistent across Windows and Linux.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.sv text eol=lf
*.svh text eol=lf
*.v text eol=lf
*.vh text eol=lf
*.tcl text eol=lf
*.xdc text eol=lf
*.md text eol=lf

# FPGA and archive artifacts are binary.
*.bit binary
*.bin binary
*.xsa binary
*.wdb binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
